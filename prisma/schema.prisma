datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Berita {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  category  String
  image     String
  excerpt   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Statistik {
  id       Int    @id @default(autoincrement())
  label    String @unique
  count    String
  iconName String
}

model Identitas {
  id    Int    @id @default(autoincrement())
  key   String @unique
  label String
  value String
}

model Prestasi {
  id       Int      @id @default(autoincrement())
  title    String
  category String
  image    String?
  message  String   @db.Text
  students String   @db.Text
  quote    String   @db.Text
  footer   String   @db.Text
}
model Profil {
  id      Int    @id @default(autoincrement())
  key     String @unique
  content String @db.Text
}

model VisiMisi {
  id      Int    @id @default(autoincrement())
  type    String // 'visi' or 'misi'
  content String @db.Text
  order   Int    @default(0)
}

model Pengajar {
  id           Int      @id @default(autoincrement())
  name         String
  nip          String
  jabatan      String
  penugasan    String
  sasaran      String
  image        String?
  isHeadmaster Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
